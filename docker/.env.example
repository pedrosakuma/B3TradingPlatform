# Copy to docker/.env and edit. The trading-host refuses to boot if the
# auth keys/seeds aren't set — that's deliberate (no insecure defaults
# leak into containers).

# JWT signing key. Must be >= 32 UTF-8 bytes and MUST NOT equal the
# committed dev-only default. Generate one:
#   openssl rand -base64 48
TRADING_AUTH_SIGNING_KEY=replace-me-with-openssl-rand-base64-48-output

# Seed user. The defaults below correspond to username "alice" with
# password "wonderland" — STRICTLY for first-time smoke testing of the
# container. Anyone reading this repo can log in with those, so generate
# fresh hash/salt for any environment beyond your laptop:
#
#   dotnet run --project backend/tools/PasswordHasher -- '<your-password>'
#   # (helper TBD; for now compute manually with PBKDF2-HMAC-SHA256,
#   #  600_000 iterations, 32-byte hash, see PasswordHasher.cs)
TRADING_SEED_USER=alice
TRADING_SEED_PASSWORD_HASH=ZDzDHANAHq8NDQK3BWk/YZjybKLCMKdRzw0z9Da5wic=
TRADING_SEED_PASSWORD_SALT=rXA+be7/gEYYZQrQDsUr2g==
# Plaintext that produced the hash/salt above. Only consumed by the
# conformance overlay (docker-compose.conformance.yml) — the trading-host
# itself never sees this value. Keep in sync when rotating credentials.
TRADING_SEED_PASSWORD=wonderland

# Host port mappings (defaults are usually fine).
TRADING_HOST_PORT=5000
FRONTEND_PORT=8080

# Optional pinning of the trading-host image (useful in CI).
# TRADING_IMAGE=ghcr.io/pedrosakuma/b3-trading-host:sha-deadbeef

# --- marketdata profile (opt-in) ---
# Bring up with: docker compose --profile marketdata up
# Requires PCAP files in PCAP_DIR.
MARKETDATA_TAG=latest
MARKETDATA_PORT=8081
PCAP_DIR=./pcap
PCAP_PREFIX=20250331_MBO_084_EQT
REPLAY_SPEED=2

# --- live reference price via marketdata WebSocket (opt-in) ---
# When set, the trading-host wires MarketDataReferencePrice in front of
# the static Risk:ReferencePrices map and the price collar uses live
# trades / info snapshots. Leave empty to keep the static behavior.
# When using --profile marketdata, point at the marketdata service:
#   TRADING_MARKETDATA_WS_URL=ws://marketdata:8080/ws
TRADING_MARKETDATA_WS_URL=
TRADING_MARKETDATA_SYMBOL_0=PETR4

# --- frontend deploy-time config ---
# Rendered into frontend/js/env.js by the frontend container entrypoint.
# Leave MARKETDATA_WS_URL empty to keep the built-in localhost/off-localhost
# fallback chain; APP_TITLE customizes the browser/login/app-shell brand text.
MARKETDATA_WS_URL=
APP_TITLE=B3TradingPlatform

# --- frontend Entra External ID login (optional; Local compatibility default) ---
# Public SPA configuration only. Do NOT add a client secret: the browser uses
# Authorization Code + PKCE through MSAL and exchanges the Entra access token at
# POST /auth/exchange for the internal trading JWT.
AUTH_MODE=Local
# AUTH_MODE=Hybrid
# AUTH_MODE=Entra
AUTH_LOCAL_LOGIN_ENABLED=
AUTH_SIGNUP_ENABLED=
AUTH_TOTP_ENABLED=
# AUTH_AUTHORITY=https://your-tenant.ciamlogin.com/your-tenant-id/v2.0
# AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AUTH_API_SCOPE=api://your-trading-api-client-id/access_as_user
# AUTH_REDIRECT_URI=http://localhost:8080/
# AUTH_LOGOUT_URI=http://localhost:8080/
# AUTH_KNOWN_AUTHORITIES=your-tenant.ciamlogin.com

# --- demo overlay (opt-in, laptop demos only) ---
# Bring up with:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.demo.yml up -d
# Flips the trading-host to Mode=Simulator and starts the demo-driver
# console which submits + injects fills continuously so the trader UI
# looks alive. NEVER enable on a host reachable beyond your laptop.
# Defaults below are committed in docker-compose.demo.yml — override
# only if rotating the demo credentials.
# DEMO_BOT_A_USER=bot-clientA
# DEMO_BOT_A_PASSWORD=demopass
# DEMO_BOT_B_USER=bot-clientB
# DEMO_BOT_B_PASSWORD=demopass
# DEMO_ADMIN_USER=demo-admin
# DEMO_ADMIN_PASSWORD=demopass
# DEMO_SUBMIT_RATE_HZ=0.5
# DEMO_INJECT_RATE_HZ=0.3
# DEMO_MAX_OPEN_ORDERS=50
# DEMO_MODE=auto-detect

# --- public FIXP exposure overlay (opt-in, internet-facing) ---
# Bring up with:
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.public.yml up -d
# Runs the trading-host in Production with the FIXP listener exposed under
# TLS + mTLS Required and hardened connection caps. EVERY value below is
# required (no dev defaults); a missing one aborts `up` fail-closed.
# See docs/operations/fixp-listener.md for cert provisioning.
# TRADING_CVM_OWNER_HASH_SALT=replace-with-real-cvm-salt
# TRADING_CLORDID_MASK_SALT=replace-with-real-clordid-mask-salt
# Host dir mounted read-only at /etc/ssl/fixp; holds server cert/key + CA + deny-list:
# PUBLIC_FIXP_TLS_DIR=/etc/ssl/fixp
# PUBLIC_FIXP_TLS_CERT=/etc/ssl/fixp/server.pfx   # or server.crt for PEM
# PUBLIC_FIXP_TLS_KEY=                            # PEM key path; empty for .pfx
# PUBLIC_FIXP_TLS_PASSWORD=                       # pfx password if any
# PUBLIC_FIXP_CA_BUNDLE=/etc/ssl/fixp/bot-ca-bundle.pem
# PUBLIC_FIXP_CA_DENYLIST=/etc/ssl/fixp/bot-denylist.txt
# PUBLIC_FIXP_PORT=5001
# PUBLIC_FIXP_MAX_CONN=200
# PUBLIC_FIXP_MAX_CONN_PER_IP=5
# PUBLIC_FIXP_ACCEPT_PER_SEC=5
# PUBLIC_FIXP_ACCEPT_BURST=20
