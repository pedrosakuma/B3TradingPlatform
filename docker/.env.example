# Copy to docker/.env and edit. The trading-host refuses to boot if the
# auth keys/seeds aren't set — that's deliberate (no insecure defaults
# leak into containers).

# JWT signing key. Must be >= 32 UTF-8 bytes and MUST NOT equal the
# committed dev-only default. Generate one:
#   openssl rand -base64 48
TRADING_AUTH_SIGNING_KEY=replace-me-with-openssl-rand-base64-48-output

# Seed user. The defaults below correspond to username "alice" with
# password "wonderland" — STRICTLY for first-time smoke testing of the
# container. Anyone reading this repo can log in with those, so generate
# fresh hash/salt for any environment beyond your laptop:
#
#   dotnet run --project backend/tools/PasswordHasher -- '<your-password>'
#   # (helper TBD; for now compute manually with PBKDF2-HMAC-SHA256,
#   #  600_000 iterations, 32-byte hash, see PasswordHasher.cs)
TRADING_SEED_USER=alice
TRADING_SEED_PASSWORD_HASH=ZDzDHANAHq8NDQK3BWk/YZjybKLCMKdRzw0z9Da5wic=
TRADING_SEED_PASSWORD_SALT=rXA+be7/gEYYZQrQDsUr2g==
# Plaintext that produced the hash/salt above. Only consumed by the
# conformance overlay (docker-compose.conformance.yml) — the trading-host
# itself never sees this value. Keep in sync when rotating credentials.
TRADING_SEED_PASSWORD=wonderland

# Host port mappings (defaults are usually fine).
TRADING_HOST_PORT=5000
FRONTEND_PORT=8080

# Optional pinning of the trading-host image (useful in CI).
# TRADING_IMAGE=ghcr.io/pedrosakuma/b3-trading-host:sha-deadbeef

# --- marketdata profile (opt-in) ---
# Bring up with: docker compose --profile marketdata up
# Requires PCAP files in PCAP_DIR.
MARKETDATA_TAG=latest
MARKETDATA_PORT=8081
PCAP_DIR=./pcap
PCAP_PREFIX=20250331_MBO_084_EQT
REPLAY_SPEED=2
