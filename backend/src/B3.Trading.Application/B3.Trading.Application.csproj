<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>B3.Trading.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\B3.Trading.Domain\B3.Trading.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Q4.8 (#308). Ship the CVM XSD inside the assembly so the writer
      can validate-on-demand and so the test suite can grab the same
      schema bytes without a separate file-IO dance.
    -->
    <EmbeddedResource Include="Reports\Cvm\Schemas\CvmReport.xsd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="B3.Trading.Api" />
    <InternalsVisibleTo Include="B3.Trading.Infrastructure" />
    <InternalsVisibleTo Include="B3.Trading.EntryPointListener" />
    <InternalsVisibleTo Include="B3.Trading.Application.Tests" />
    <InternalsVisibleTo Include="B3.Trading.Api.Tests" />
    <InternalsVisibleTo Include="B3.Trading.EntryPointListener.Tests" />
    <InternalsVisibleTo Include="B3.Trading.Benchmarks" />
  </ItemGroup>

</Project>
