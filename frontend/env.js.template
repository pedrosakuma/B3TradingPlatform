// Deploy-time configuration for the static frontend. This file is a
// template: the entrypoint script (docker-entrypoint.d/20-render-env-js.sh)
// renders it into /usr/share/nginx/html/js/env.js at container start,
// substituting JSON-escaped MARKETDATA_WS_URL and APP_TITLE environment
// variables.
//
// Loaded as a plain classic <script> in index.html BEFORE js/app.js (which
// is a deferred type=module script), so window.__B3_CONFIG__ is guaranteed
// to exist by the time js/app.js / js/protocol.js read it.
//
// MARKETDATA_WS_URL lets each orchestrator (docker-compose dev, b3deploy
// prod AKS, ...) ship the correct marketdata WS endpoint (host/port varies
// per environment — e.g. a shared LB IP + distinct port on AKS) instead of
// every operator pasting it into the Market Data panel by hand every
// session. Empty by default, which preserves today's behavior: protocol.js
// falls back to its localhost/127.0.0.1 dev guess, then "". See #572.
//
// APP_TITLE lets deployers replace the static B3TradingPlatform brand text
// in the browser title + login/app-shell headings without rebuilding the
// frontend image. Defaults to "B3TradingPlatform". See #596.
window.__B3_CONFIG__ = {
  marketDataWsUrl: __MARKETDATA_WS_URL_JSON__,
  appTitle: __APP_TITLE_JSON__,
};
