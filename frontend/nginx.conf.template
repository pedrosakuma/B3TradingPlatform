# nginx reverse-proxy for the trading-host backend.
#
# The frontend served from this container is static (HTML/CSS/JS). It needs
# the trading-host's REST + WebSocket surface on the SAME ORIGIN so the
# browser doesn't trip on CORS and so frontend/js/protocol.js's
# defaultBackend() (= location.origin for non-localhost) just works.
#
# Upstream is resolved via the platform's service-discovery DNS name
# (docker-compose bridge: "trading-host"; Kubernetes: a Service name/FQDN,
# configurable via TRADING_UPSTREAM). We use a `resolver` so nginx doesn't
# cache a NXDOMAIN at startup if trading-host isn't up yet.
#
# nginx's `resolver` directive does NOT apply /etc/resolv.conf `search`
# domains the way libc does, so a bare short name (e.g. "trading-host")
# resolves fine under Docker's embedded DNS but is NXDOMAIN on Kubernetes,
# where the Service is only reachable at its (partially-)qualified name
# (e.g. "trading-host.<namespace>.svc.cluster.local"). Deployers set
# TRADING_UPSTREAM to the FQDN:port in that case. See #564.
#
# This file is a template: the entrypoint script
# (docker-entrypoint.d/25-render-nginx-conf.sh) envsubst's it into
# /etc/nginx/nginx.conf at container start, substituting ${NGINX_RESOLVER}
# and ${TRADING_UPSTREAM}.
# `resolver local=on;` (NGINX Plus only) is NOT available in the open-source
# nginx this image ships, so the resolver address must come from the
# environment instead: default 127.0.0.11 (Docker's embedded DNS) for
# docker-compose; Kubernetes/AKS deploys set NGINX_RESOLVER to the cluster
# DNS ClusterIP (e.g. CoreDNS/kube-dns, discoverable from
# /etc/resolv.conf inside any pod) — see #562. Do NOT hardcode 127.0.0.11
# back into this file; that only exists on Docker's default bridge network.

worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # Resolver address is templated from $NGINX_RESOLVER at container start
    # (default: 127.0.0.11, Docker's embedded DNS). See #562.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # WebSocket upgrade switch. nginx default Connection header would close
    # the upgrade, this map preserves it when the client asked for one.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Pass-1 review (#327) P2 — `/ws/dropcopy` (and other websocket
    # paths added in the future) carry the JWT in the `?access_token=`
    # query string because browsers cannot set the `Authorization`
    # header on `new WebSocket(...)`. nginx's default `combined` access
    # log includes the full request line (which embeds the query), so
    # bearer tokens would otherwise persist in container/host log files
    # and any sidecar log shipper. We disable access logging for every
    # `/ws*` request to keep tokens out of disk-resident logs.
    map $uri $access_token_loggable {
        default 1;
        ~^/ws    0;
    }

    # Map of paths that get proxied to the trading-host. Anything else is
    # served as a static file from /usr/share/nginx/html.
    map $uri $is_api {
        default                              0;
        ~^/api(/|$)                          1;
        ~^/health(/|$)                       1;
        ~^/ready(/|$)                        1;
        ~^/live(/|$)                         1;
        ~^/ws(/|$|\?)                        1;
    }

    server {
        listen 80 default_server;
        server_name _;

        # Pass-1 review (#327) P2 — keep WebSocket auth tokens
        # (`?access_token=...`) out of the on-disk access log.
        access_log /var/log/nginx/access.log combined if=$access_token_loggable;

        # ── Security headers (section 4 of #30) ──────────────────────
        # Applied to ALL responses (static + proxied) via add_header at
        # the server level. CSP is intentionally strict:
        #   - no inline scripts (we use ES modules served as files)
        #   - no inline styles (refactored to CSS classes)
        #   - connect-src is rendered from same-origin plus configured Entra and
        #     market-data origins; no broad wildcard or ws:/wss: scheme source
        #     is added. Empty MARKETDATA_WS_URL keeps only the documented
        #     localhost dev websocket origins.
        #   - frame-src is limited to self plus configured Entra authority
        #     origins for MSAL silent token renewal.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self' ${CSP_CONNECT_SOURCES}; frame-src 'self' ${CSP_FRAME_SOURCES}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

        # Static frontend
        root /usr/share/nginx/html;
        index index.html;

        # Static files first; SPA-style fallback to index.html on 404 keeps
        # future client routing painless.
        location / {
            if ($is_api) {
                rewrite ^ /__proxy$uri last;
            }
            try_files $uri $uri/ /index.html;
        }

        # Internal proxy target. Named `__proxy` so it can never collide with
        # a real frontend route. Uses a variable for the upstream so nginx
        # re-resolves the docker DNS name on each request (no boot-order pain).
        location ~ ^/__proxy(?<orig_path>/.*)$ {
            internal;

            set $trading_upstream "${TRADING_UPSTREAM}";

            # WebSocket upgrade headers are harmless on plain HTTP responses,
            # so we set them unconditionally rather than branching on path.
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;

            proxy_buffering    off;
            proxy_read_timeout 1h;   # WS sessions can sit idle between events
            proxy_send_timeout 1h;

            proxy_pass http://$trading_upstream$orig_path$is_args$args;
        }
    }

    # WebSocket upgrade switch defined above near other map() directives.
}
